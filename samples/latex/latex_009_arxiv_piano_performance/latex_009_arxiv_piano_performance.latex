  \includegraphics[width=0.95\columnwidth]{figs/dynamics_vs_note_offset_velocity.pdf}
  \captionsetup{width=.95\columnwidth}
  \caption{Relationship between model performance evaluated on note-offset-velocity F1 score and our proposed dynamics measure.}
  \label{fig:dynamics_vs-fnov}
\end{figure}


